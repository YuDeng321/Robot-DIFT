    "inference": [
      "examples/extract_features.py",
      "agents/encoders/robot_dift_student_feature_extractor.py"
    ]
  },
  "external_assets": [
    {
      "environment_variable": "ROBOT_DIFT_DATA_ROOT",
      "kind": "dataset",
      "role": "DROID TFDS dataset"
    },
    {
      "environment_variable": "ROBOT_DIFT_MODEL_DIR",
      "kind": "pretrained_model",
      "role": "SD2.1 Diffusers model"
    },
    {
      "environment_variable": "ROBOT_DIFT_CLIP_MODEL",
      "kind": "pretrained_model",
      "role": "CLIP ViT-B/32 text tower (Stage I and Stage II readout and language goal)"
    },
    {
      "environment_variable": "ROBOT_DIFT_STAGE1_ENCODER",
      "kind": "trained_checkpoint",
      "role": "trained Student encoder"
    }
  ],
